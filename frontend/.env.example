# Build-time (CRA inlines REACT_APP_* into the client bundle)
REACT_APP_GA_MEASUREMENT_ID=G-2YMJF3VYZ2
# Optional — leave blank on the NEW main-site Vercel project unless intentionally configured.
# Do NOT copy the Ads landing-page GTM container (GTM-KZH5PCBS) here by default.
# REACT_APP_GTM_ID=
# REACT_APP_META_PIXEL_ID=
# REACT_APP_BACKEND_URL=   # only if admin/legacy FastAPI is needed; leave empty for public Vercel site

# Serverless form delivery (Vercel project env — not REACT_APP_*)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@carenesthomehealth.in
# LEAD_FROM_EMAIL=CareNest Website <onboarding@resend.dev>
# FORM_DEV_ACCEPT=true   # accept forms without Resend on non-production / preview testing
