# Canonical backend env for CareNest (copy to backend/.env on the Emergent workspace).
# Never commit real secrets.

MONGO_URL=
DB_NAME=
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=CareNest Home Health
LEAD_NOTIFY_EMAIL=info@carenesthomehealth.in
ADMIN_TOKEN=
CORS_ORIGINS=*

# Public analytics IDs (safe to expose to the browser via /api/config/public)
GA_MEASUREMENT_ID=
GTM_ID=
META_PIXEL_ID=

# IMPORTANT — Emergent production (carenesthomehealth.in / *.emergent.host):
# Preview and Production secrets are SEPARATE. Editing this file updates preview
# immediately (after backend reload), but redeploy does NOT overwrite existing
# production secrets — it only adds NEW keys. If GA_MEASUREMENT_ID was first
# synced as empty, production keeps returning ga_id="" until you update the
# value in Emergent → Deployment → Secrets (or set REACT_APP_GA_MEASUREMENT_ID
# for a frontend build-time fallback).
