# CareNest frontend build-time env — copy to /opt/carenest/app/frontend/.env before `yarn build`
# CRA inlines REACT_APP_* at build time.

REACT_APP_BACKEND_URL=https://carenesthomehealth.in

# Optional build-time analytics fallbacks (prefer backend GA_MEASUREMENT_ID via /api/config/public)
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXX
# REACT_APP_GTM_ID=GTM-XXXXXXX
# REACT_APP_META_PIXEL_ID=
