# CareNest backend environment — copy to /opt/carenest/app/backend/.env
# chmod 600 this file. NEVER commit real values.

# ---------- Database ----------
MONGO_URL=mongodb://carenest:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:27017/carenest?authSource=carenest
# Atlas example:
# MONGO_URL=mongodb+srv://carenest:PASSWORD@cluster.xxxxx.mongodb.net/carenest?retryWrites=true&w=majority
DB_NAME=carenest

# ---------- Admin ----------
# Copy from Emergent production ADMIN_TOKEN (or rotate and update operators)
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# ---------- Email (AWS SES SMTP — replaces EMERGENT_EMAIL_KEY) ----------
EMAIL_FROM_NAME=CareNest Home Health
EMAIL_FROM=info@carenesthomehealth.in
LEAD_NOTIFY_EMAIL=info@carenesthomehealth.in
SES_REGION=ap-south-1
SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=CHANGE_ME_SES_SMTP_USER
SES_SMTP_PASS=CHANGE_ME_SES_SMTP_PASSWORD

# ---------- Chat LLM (Anthropic — replaces EMERGENT_LLM_KEY) ----------
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---------- CORS ----------
CORS_ORIGINS=https://carenesthomehealth.in,https://www.carenesthomehealth.in

# ---------- Public analytics (optional) ----------
GA_MEASUREMENT_ID=
GTM_ID=
META_PIXEL_ID=

# ---------- Legacy Emergent keys (LEAVE EMPTY after cutover) ----------
# EMERGENT_LLM_KEY=
# EMERGENT_EMAIL_KEY=
