# Optional — migrate.sh auto-detects backend/.env and prompts for anything missing.
# Prefer: sudo bash deploy/scripts/migrate.sh
#
# If you want zero prompts, pre-fill /etc/carenest/cutover.env:

# EMERGENT_MONGO_URL=mongodb+srv://...
# EMERGENT_DB_NAME=your_emergent_db
# GA_MEASUREMENT_ID=G-XXXXXXXX
# GTM_ID=GTM-XXXXXXX
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=          # optional — auto-resolved from domain
# CLOUDFLARE_ORIGIN_CA_KEY=    # auto-creates origin cert (or place PEMs at paths below)
# CF_ORIGIN_CERT=/etc/ssl/cloudflare/carenest.pem
# CF_ORIGIN_KEY=/etc/ssl/cloudflare/carenest.key
# CUTOVER_SSL_MODE=cloudflare
# SKIP_MONGO=0
