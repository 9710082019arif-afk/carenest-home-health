# Auto-created/updated by deploy/scripts/migrate.sh — prefer running the wizard.
# Placeholder localhost / CHANGE_ME URIs in backend/.env are IGNORED.

# Atlas (required always — even with SKIP_MONGO=1)
# MONGO_URL=mongodb+srv://USER:PASS@CLUSTER/carenest?retryWrites=true&w=majority

# Emergent dump/restore only (SKIP_MONGO=1 skips this — not Atlas)
# EMERGENT_MONGO_URL=mongodb+srv://...
# EMERGENT_DB_NAME=

# GA_MEASUREMENT_ID=G-XXXXXXXX
# GTM_ID=GTM-XXXXXXX

# Cloudflare cutover:
#   CUTOVER_CF_MODE=manual   # no API token / Origin CA Key — DNS/SSL via dashboard
#   CUTOVER_CF_MODE=api      # automated (needs token + Origin CA Key)
# MANUAL_CLOUDFLARE=1        # same as CUTOVER_CF_MODE=manual
# CUTOVER_CF_MODE=manual

# Only for CUTOVER_CF_MODE=api:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ORIGIN_CA_KEY=
# CF_ORIGIN_CERT=/etc/ssl/cloudflare/carenest.pem
# CF_ORIGIN_KEY=/etc/ssl/cloudflare/carenest.key

# SKIP_MONGO=0
