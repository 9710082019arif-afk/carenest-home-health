# Optional secrets for same-day cutover — copy to /etc/carenest/cutover.env
#   sudo cp deploy/env/cutover.env.example /etc/carenest/cutover.env
#   sudo nano /etc/carenest/cutover.env
# Then: sudo bash deploy/scripts/cutover_today.sh

# Final Mongo sync from Emergent (omit + SKIP_MONGO=1 if Atlas already final)
# EMERGENT_MONGO_URL=mongodb+srv://...
# EMERGENT_DB_NAME=your_emergent_db_name

# Analytics (written into backend/.env automatically)
# GA_MEASUREMENT_ID=G-XXXXXXXX
# GTM_ID=GTM-XXXXXXX
# META_PIXEL_ID=

# Cloudflare API (makes DNS flip + purge + SSL mode automatic)
# Create token: Zone.DNS Edit + Cache Purge + Zone Settings Edit
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Origin SSL (Cloudflare Origin Certificate PEM paths)
# CUTOVER_SSL_MODE=cloudflare
# CF_ORIGIN_CERT=/etc/ssl/cloudflare/carenest.pem
# CF_ORIGIN_KEY=/etc/ssl/cloudflare/carenest.key

# Or: CUTOVER_SSL_MODE=certbot
# CERTBOT_EMAIL=info@carenesthomehealth.in

# SKIP_MONGO=0
# SKIP_DNS=0
# SKIP_CHAT=0
# SKIP_LEAD=0
