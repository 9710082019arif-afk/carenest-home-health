# CareNest main website (Vercel)
# Copy to .env.local for development

# Optional override — defaults to G-2YMJF3VYZ2 in code
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2YMJF3VYZ2

# Optional Google Search Console verification meta content value
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set true ONLY on the Vercel Production deployment that should be indexed
# (normally VERCEL_ENV=production is enough; keep false on temporary review projects)
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Form delivery via Resend (recommended for Vercel)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@carenesthomehealth.in
LEAD_FROM_EMAIL=CareNest Website <onboarding@resend.dev>

# Local-only: accept forms without Resend (logs to server console)
FORM_DEV_ACCEPT=true
